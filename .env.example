# ============================================================================
# Karacter Hub - Environment Variables
# ============================================================================

# -----------------------------------------------------------------------------
# AI Model Configuration
# -----------------------------------------------------------------------------

# Neon PostgreSQL pooled connection string (server-side only)
DATABASE_URL=

# Primary AI provider (default: Mistral Vibe)
# The AI SDK uses this model for generation and refactoring
NEXT_PUBLIC_AI_MODEL=mistral-large

# Mistral AI API Key (for Mistral models)
# Get yours at: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your_mistral_api_key_here

# Alternative providers (optional - for multi-provider support)
# OpenAI
OPENAI_API_KEY=
# Anthropic
ANTHROPIC_API_KEY=
# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=

# -----------------------------------------------------------------------------
# GitHub Configuration
# -----------------------------------------------------------------------------

# GitHub OAuth Client ID (for production OAuth flow)
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# GitHub OAuth Client Secret
GITHUB_CLIENT_SECRET=

# GitHub OAuth Redirect URI
NEXT_PUBLIC_GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback/github

# Personal Access Token (for development - alternative to OAuth)
# Create at: https://github.com/settings/tokens
# Required scopes: repo, user, workflow
GITHUB_PERSONAL_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

# Application URL (used for callbacks, sharing, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session secret (for auth - generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_session_secret_here

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------

# Content Security Policy (CSP) - for production
# This is handled in next.config.mjs headers

# Rate limiting for API endpoints (optional)
# RATE_LIMIT_MAX_REQUESTS=10
# RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# WebContainer Configuration
# -----------------------------------------------------------------------------

# WebContainer CDN URL (optional - uses default if not specified)
# NEXT_PUBLIC_WEBCONTAINER_CDN=https://unpkg.com/@webcontainer/api@1.6.4/dist/

# -----------------------------------------------------------------------------
# Development / Debugging
# -----------------------------------------------------------------------------

# Enable verbose logging (development only)
NEXT_PUBLIC_DEBUG=false

# Disable authentication in development (for testing)
NEXT_PUBLIC_DISABLE_AUTH=false
