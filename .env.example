# ============================================================================
# Karacter Hub - Environment Variables
# ============================================================================

# -----------------------------------------------------------------------------
# AI Model Configuration
# -----------------------------------------------------------------------------

# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Neon PostgreSQL URLs. Use the pooled URL at runtime and the unpooled URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Non-secret model selector. Vercel AI Gateway is used when its key is configured.
NEXT_PUBLIC_AI_MODEL=mistral-large
# Optional: set to byo to use a supplied provider key instead of Vercel AI Gateway.
AI_PROVIDER_MODE=

# Vercel AI Gateway key; alternatively configure a provider key below.
AI_GATEWAY_API_KEY=

# Optional BYO provider keys. Never prefix credentials with NEXT_PUBLIC_.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GOOGLE_GEMINI_BASE_URL=
OPENROUTER_BASE_URL=

# -----------------------------------------------------------------------------
# GitHub Configuration
# -----------------------------------------------------------------------------

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Auth.js trusts Vercel's deployment host automatically; set true only behind a trusted proxy.
AUTH_TRUST_HOST=

# OAuth identity providers (optional; each appears when both values are set)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email verification and sign-in links (required for password sign-up)
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=KaracterHub <no-reply@example.com>

# Personal Access Token (for development - alternative to OAuth)
# Create at: https://github.com/settings/tokens
# Required scopes: repo, user, workflow
GITHUB_PERSONAL_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

# Application URL (used for callbacks, sharing, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NEXTAUTH_SECRET is accepted as a temporary fallback; prefer AUTH_SECRET.
NEXTAUTH_SECRET=

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------

# Content Security Policy (CSP) - for production
# This is handled in next.config.mjs headers

# Rate limiting for API endpoints (optional)
# RATE_LIMIT_MAX_REQUESTS=10
# RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# WebContainer Configuration
# -----------------------------------------------------------------------------

# WebContainer CDN URL (optional - uses default if not specified)
# NEXT_PUBLIC_WEBCONTAINER_CDN=https://unpkg.com/@webcontainer/api@1.6.4/dist/

# -----------------------------------------------------------------------------
# Development / Debugging
# -----------------------------------------------------------------------------

# Enable verbose logging (development only)
NEXT_PUBLIC_DEBUG=false # Authentication is always enforced for the workspace and protected APIs.
