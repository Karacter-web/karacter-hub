    "@webcontainer/api": "^1.6.4",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^1.0.0-beta.22",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.27.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "zustand": "^5.0.15"
